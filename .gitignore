# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env files
.env.local
.env*.local

# claude code (local dev tooling)
.claude/
.claude-port
.git-env
__pycache__/

# framework state
.context/
.qa-reports/
.fw-sync-backups/
.sherlock-plan.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel (commit project.json so worktrees can deploy)
.vercel/
!.vercel/project.json

# typescript
*.tsbuildinfo
next-env.d.ts
.fw-sync-cache/

# internal dev tooling
scripts/generate_dashboard.py

# worktrees
test-results/
/private/
